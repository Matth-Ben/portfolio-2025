---
// Composant de transition de page avec GSAP - Transitions personnalisées par route
---

<div id="page-transition" class="fixed inset-0 z-50 pointer-events-none">
  <div id="transition-overlay" class="absolute inset-0 bg-primary transform translate-y-full"></div>
</div>

<script>
  import { PageTransitionManager } from '../utils/transitions';

  // Fonction pour initialiser les transitions de page
  function initPageTransitions() {
    const transitionManager = PageTransitionManager.getInstance();

    // Vérifier que GSAP est disponible
    if (!window.gsap) {
      console.warn('GSAP not loaded, page transitions disabled');
      return;
    }

    // Fonction pour démarrer la transition d'entrée
    function startPageTransition() {
      const loader = document.getElementById('page-loader');
      if (loader && loader.style.display !== 'none') {
        // Attendre que le loader soit masqué
        setTimeout(startPageTransition, 100);
        return;
      }

      // Initialiser l'animation d'entrée basée sur la transition précédente
      transitionManager.initPageEnter();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', startPageTransition);
    } else {
      startPageTransition();
    }

    // Gérer les transitions lors de la navigation
    if (typeof window !== 'undefined' && window.history) {
      // Stocker l'URL actuelle pour détecter le sens de navigation
      let currentUrl = window.location.href;

      // Intercepter les clics sur les liens internes
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const link = target?.closest('a');

        if (!link) return;

        const href = link.getAttribute('href');

        // Ignorer les liens externes, ancres, mailto, etc.
        if (!href || href.startsWith('#') || href.startsWith('http') || href.startsWith('mailto:')) {
          return;
        }

        e.preventDefault();

        // Sauvegarder l'URL actuelle AVANT de la changer
        const fromUrl = currentUrl;
        const fullUrl = new URL(href, window.location.origin).href;

        // Préparer la transition (stocke le type dans sessionStorage)
        // IMPORTANT: Utiliser fromUrl au lieu de window.location.href
        transitionManager.prepareTransitionFromTo(fromUrl, fullUrl);

        // Exécuter la transition de sortie puis naviguer
        // Note: On ne fait pas de pushState ici car transitionToFrom fait déjà window.location.href
        transitionManager.transitionToFrom(fullUrl, fromUrl);
      });

      // Gérer les boutons retour/avant du navigateur
      window.addEventListener('popstate', (e) => {
        const newUrl = window.location.href;

        // Préparer la transition pour le retour en arrière
        transitionManager.prepareTransition(newUrl);

        // Exécuter la transition puis recharger
        transitionManager.exitWithNavigate(newUrl, { skipHistoryPush: true });
      });

      // Réinitialiser l'état lors du chargement d'une nouvelle page
      window.addEventListener('pageshow', (e) => {
        transitionManager.reset();

        // Détecter si c'est un retour via cache du navigateur (bfcache)
        if (e.persisted) {
          // Réinitialiser l'état visuel si la page vient du cache
          const mainContent = document.querySelector('main');
          if (mainContent) {
            window.gsap.set(mainContent, { opacity: 1, x: 0, y: 0, scale: 1, clearProps: 'transform' });
          }
        }
      });

      // Mettre à jour l'URL actuelle après chaque navigation
      currentUrl = window.location.href;
    }
  }

  // Initialiser les transitions
  initPageTransitions();
</script> 